DB_URL=jdbc:postgresql://localhost:5432/template
DB_USERNAME=template
DB_PASSWORD=change-this-database-password

# Generate with: openssl rand -base64 32
APP_JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
APP_JWT_ISSUER=template-api
APP_JWT_EXPIRATION=PT1H

# Exact browser origins, comma-separated. No path or trailing slash.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://example.com,https://app.example.com

# Enable only for the first startup, then disable it.
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Import bundled persons.json mock data. Set false in production if not wanted.
APP_BOOTSTRAP_PERSONS_ENABLED=true
